# FRR daemons for this node. zebra, mgmtd and staticd always run.
bgpd=yes
ospfd=yes
ospf6d=yes
bfdd=yes
ripd=no
ripngd=no
isisd=no
pimd=no
ldpd=no
vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
mgmtd_options="  -A 127.0.0.1"
bgpd_options="   -A 127.0.0.1"
ospfd_options="  -A 127.0.0.1"
ospf6d_options=" -A ::1"
bfdd_options="   -A 127.0.0.1"
staticd_options="-A 127.0.0.1"
